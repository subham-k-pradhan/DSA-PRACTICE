/*
  Reverse Integer

  Time Complexity: O(log10 n)
  Space Complexity: O(1)
 */

class Solution {

    public int reverse(int x) {

        
        int revnum = 0;

        while (x != 0) {

            // Extract last digit
            int digit = x % 10;

          
            revnum = revnum * 10 + digit;

            // Remove last digit
            x = x / 10;
        }

        // Return reversed integer
        return revnum;
    }
}
