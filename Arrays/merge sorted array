// in this particular problem i use two pointer approach (backward two pointer approach to merge array)
//time and space complexity O(m+n),O(1)
// here i use 3 pointer

class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {

        int i = m - 1;
        int j = n - 1;
        int k = m + n - 1;


       
        while (i >= 0 && j >= 0) {

            if (nums1[i] > nums2[j]) {
                nums1[k] = nums1[i];
                i--;
            } else {
                nums1[k] = nums2[j];
                j--;
            }

            k--;
        }

        // for remanining part
        while (i >= 0) {
            nums1[k] = nums1[i];
            i--;
            k--;
        }

         // for remanining part
        while (j >= 0) {
            nums1[k] = nums2[j];
            j--;
            k--;
        }
    }
}
