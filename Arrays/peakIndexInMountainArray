

//A mountain array first increases and then decreases.
//i use Binary Search to find the peak element efficiently.
//Binary Search divides the array into half repeatedly.  so   time and space complexity O(logn),O(1)

// if i give example  [0, 2, 5, 3, 1]    in this array Peak element is  5

class Solution {

    public int peakIndexInMountainArray(int[] arr) {

        int start = 0;
        int end = arr.length - 1;

        int ans = -1;

        while (start <= end) {

            int mid = start + (end - start) / 2;

            // Descending side
            if (arr[mid] > arr[mid + 1]) {

                ans = mid;
                end = mid - 1;
            }

            // Increasing side
            else {
                start = mid + 1;
            }
        }

        return ans;
    }
}
