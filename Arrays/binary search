
//time complx is O(log n) and space (O) 
// check middle and we go left and right

class Solution {
    public int search(int[] nums, int target) {
        int st = 0;
        int end= nums.length- 1 ;
        
     while(st<=end){
        int mid = (st + end)/2;

//target is found

        if(nums[mid]==target){
            return mid;
            }
        else if(nums[mid]> target){
            end = mid-1;
        }
        else {
            st = mid + 1;
        }

     }   
// target not found

     return -1;
    }
}
