// i use this formula (i + k) % n
// i = current index
// k = number of rotations
// n = array length
// Time Complexity and Space Complexity is O(n)


class Solution {

    public void rotate(int[] nums, int k) {

        int n = nums.length;

      
        k = k % n;

        int[] result = new int[n];

        // Rotate elements
        for(int i = 0; i < n; i++) {

            result[(i + k) % n] = nums[i];
        }

        // Copy back to original array
        for(int i = 0; i < n; i++) {

            nums[i] = result[i];
        }
    }
}
