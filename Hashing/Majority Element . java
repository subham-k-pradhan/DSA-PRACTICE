Approach:
1. Store the frequency of each character from string s in a HashMap.
2. Traverse string t and decrease the corresponding character frequency.
3. If a character is not present in the map, return false.
4. Remove a character when its frequency becomes 0.
5. If the map is empty at the end, both strings are anagrams.

Time Complexity: O(n + m)
Space Complexity: O(k)





  import java.util.*;

class Solution {
    public boolean isAnagram(String s, String t) {

        HashMap<Character, Integer> map = new HashMap<>();

        // Count frequency of characters in s
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            map.put(ch, map.getOrDefault(ch, 0) + 1);
        }

        // Decrease frequency using characters from t
        for (int i = 0; i < t.length(); i++) {
            char ch = t.charAt(i);

            if (map.get(ch) != null) {

                if (map.get(ch) == 1) {
                    map.remove(ch);
                } else {
                    map.put(ch, map.get(ch) - 1);
                }

            } else {
                return false;
            }
        }

        return map.isEmpty();
    }
}
