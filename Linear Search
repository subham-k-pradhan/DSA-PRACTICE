/**
 * Linear Search Function
 * Searches the target element in the array.
 * Returns the index if found, otherwise returns -1.
 */

public static int linearSearch(int[] arr, int target) {

    for (int i = 0; i < arr.length; i++) {

        if (arr[i] == target) {
            return i;
        }
    }

    return -1;
}
