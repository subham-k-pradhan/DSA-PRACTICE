//time and space complexity O(logn),O(1)
// here we use binary search
//In a rotated sorted array, at least one half of the array is always sorted

// we identify the sorted half
// check whether the target lies inside it
// discard the other half


class Solution {
    public int search(int[] nums, int target) {

        int left = 0;
        int right = nums.length - 1;

        while(left <= right){

            int mid = left + (right - left) / 2;

            if(nums[mid] == target){
                return mid;
            }

            // Left half sorted
            if(nums[left] <= nums[mid]){

                if(target >= nums[left] && target < nums[mid]){
                    right = mid - 1;
                } 
                else {
                    left = mid + 1;
                }

            } 
            // Right half sorted
            else {

                if(target > nums[mid] && target <= nums[right]){
                    left = mid + 1;
                } 
                else {
                    right = mid - 1;
                }
            }
        }

        return -1;
    }
}
